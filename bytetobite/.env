# ═══════════════════════════════════════════════════════════════
# ByteToBite — Environment Configuration
#
# Copy this file to `.env` and fill in real values for production.
# Docker Compose reads this automatically.
# The backend reads these via os.getenv() in db.py, otp.py, payment.py.
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
# Inside docker-compose the host is "db" (service name).
# For running the backend directly on your host, use "localhost".
DATABASE_URL=postgresql://user:pass@db:5432/bytetobite

# ─────────────────────────────────────────────
# REDIS (WebSocket fan-out)
# ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─────────────────────────────────────────────
# JWT (session tokens)
# ─────────────────────────────────────────────
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-this-to-a-64-char-random-string-for-production-please-do-not-use-this-in-real-deploy
JWT_EXPIRES_DAYS=7

# ─────────────────────────────────────────────
# OTP (SMS verification)
# ─────────────────────────────────────────────
# Pepper is added to every OTP hash so DB dumps can't be replayed.
OTP_PEPPER=change-this-otp-pepper-to-something-random

# ─────────────────────────────────────────────
# RAZORPAY (payments)
# ─────────────────────────────────────────────
# Test keys:  https://dashboard.razorpay.com/app/keys
# Live keys start with "rzp_live_"; test keys start with "rzp_test_".
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# ─────────────────────────────────────────────
# MAPS: 100% FREE & ZERO API KEY REQUIRED
# (All maps use OpenStreetMap & CARTO CDN tile layers directly)
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# CORS (frontend origins allowed to call the API)
# ─────────────────────────────────────────────
# Comma-separated. Use "*" only in development.
ALLOWED_ORIGINS=*